# Application Configuration
APP_NAME=AgriSensa Harvest Intelligence API
APP_ENV=development
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0

# CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://app.agrisensa.ai

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrisensa_harvest

# Google Drive Integration (Service Account)
# Masukkan salah satu: file JSON lokal atau isi JSON string (untuk Railway / Cloud)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# n8n & Google Workspace Integration
N8N_WEBHOOK_HARVEST_CREATED=https://n8n.agrisensa.ai/webhook/harvest-created
N8N_WEBHOOK_SECRET=your-webhook-secret-token

